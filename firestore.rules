rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth.token.email.split('@')[0]; }
    match /couples/{pair} {
      allow read: if request.auth != null && (resource == null || me() in resource.data.members);
      allow create: if request.auth != null && request.resource.data.members.size() == 2
                    && me() in request.resource.data.members
                    && pair == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if request.auth != null && me() in resource.data.members
                    && request.resource.data.members == resource.data.members;
      match /loc/{p} {
        function ok() { return me() in get(/databases/$(db)/documents/couples/$(pair)).data.members; }
        allow read: if request.auth != null && ok();
        allow write: if request.auth != null && ok() && me() == p;
      }
    }
  }
}
